# Telegram
BOT_TOKEN=
ADMINS=

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_HOST=db
DB_PORT=5432

# Cache (optional)
CACHE_TTL_DAYS=7

# qBittorrent send-to-server (admin only; leave unset to disable)
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_CATEGORY=tj-bot
SEARCH_CACHE_SECONDS=3600

# Admin alerts: indexer down / low disk space (interval 0 disables)
ALERT_CHECK_INTERVAL_SECONDS=1800
ALERT_FREE_SPACE_GB=10

# Search-card enrichment: tracker page -> metadata (optional)
ENRICH_ENABLED=true
SCRAPE_PROXY_URL=
FLARESOLVERR_URL=http://flaresolverr:8191
TAPOCHEK_USERNAME=
TAPOCHEK_PASSWORD=
ENRICH_FETCH_TIMEOUT_SECONDS=20
